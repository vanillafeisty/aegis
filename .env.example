# LinkedIn Credentials
# Get these from your LinkedIn session (DevTools > Application > Cookies > li_at)
LINKEDIN_SESSION_COOKIE=paste_your_linkedin_session_cookie_here

# Get from DevTools or LinkedIn API
LINKEDIN_ACCESS_TOKEN=paste_your_linkedin_access_token_here

# From LinkedIn App Registration (optional but recommended)
LINKEDIN_CLIENT_ID=paste_your_linkedin_client_id_here

# OpenAI API Key
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste_your_openai_api_key_here

# Gmail Credentials
# Your Gmail address
SMTP_EMAIL=your.email@gmail.com

# Gmail App Password (NOT your regular password!)
# Get from https://myaccount.google.com/apppasswords
SMTP_PASSWORD=paste_your_gmail_app_password_here
