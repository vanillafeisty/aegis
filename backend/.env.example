# ==================== REQUIRED ====================
# Groq LLM API (Free - https://console.groq.com/keys)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Gmail SMTP (Use App Password, not regular password)
# Generate here: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ==================== LINKEDIN OAUTH 2.0 (Recommended) ====================
# Create a LinkedIn Developer App at: https://www.linkedin.com/developers/apps
# 1. Set the Redirect URI to: http://localhost:8000/callback
# 2. Enable the "Sign In with LinkedIn using OpenID Connect" product
# 3. Optionally enable "Share on LinkedIn" or "Community Management API" for posting
LINKEDIN_CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:8000/callback

# NOTE: LINKEDIN_ACCESS_TOKEN is now managed automatically by the OAuth flow.
# You do NOT need to set it manually. It will be stored in linkedin_token.json.

# ==================== LINKEDIN SESSION COOKIE (Legacy Fallback) ====================
# Only needed if OAuth posting scopes are not available.
# Used for Playwright browser automation (connection requests, cold messaging, inbox).
# Get from DevTools: Application -> Cookies -> linkedin.com -> li_at
# Expires every 30-60 days — refresh when needed.
LINKEDIN_SESSION_COOKIE=AQED...your-session-cookie...

# ==================== OPTIONAL - Zapier MCP ====================
# Zapier MCP Server URL (for workflow automation)
ZAPIER_MCP_URL=https://mcp.zapier.com/api/v1

# ==================== DEPLOYMENT ====================
# Set to "production" for cloud deployment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
